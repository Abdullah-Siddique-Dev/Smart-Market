{
  "name": "smart-market",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently \"pnpm --dir server dev\" \"vite\"",
    "build": "tsc && vite build",
    "build:server": "pnpm --dir server build",
    "build:all": "pnpm build && pnpm build:server",
    "build:launcher": "C:\\MinGW\\bin\\gcc.exe -O3 -mwindows -o \"Smart Market OS.exe\" launcher.c",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:build": "pnpm build && tauri build",
    "tauri:dev": "concurrently \"pnpm --dir server dev\" \"tauri dev\"",
    "server:dev": "pnpm --dir server dev",
    "server:test": "pnpm --dir server test:smoke"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-table": "^8.21.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.54.2",
    "react-hotkeys-hook": "^4.6.1",
    "react-router-dom": "^6.28.2",
    "recharts": "^2.15.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.13.9",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

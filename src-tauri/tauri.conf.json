{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smart Market OS",
  "version": "1.0.0",
  "identifier": "com.smartmarket.os",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && pnpm build:server",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Smart Market OS — Wholesale & Distribution ERP",
        "width": 1366,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ]
  }
}
